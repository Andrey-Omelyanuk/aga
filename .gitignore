# Rust
target/
Cargo.lock

# Logs and temp files
*.log
*.tmp

# Environment (создаётся из infra/.env.example через make init)
.env
.env.local

# Runtime data (создаётся при запуске)
data/trace.db
data/trace.db-wal
data/trace.db-shm
data/work/*
