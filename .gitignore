# Config generated by `make init`
config/roles.yaml

# Runtime nginx config (генерируется infra/k8s/local-proxy.sh start)
infra/k8s/local-proxy/run/

# Editors
.vscode/
.idea/

# Coverage
coverage/
htmlcov/
.coverage
.mypy_cache/
.pytest_cache/
