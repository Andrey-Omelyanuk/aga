# Rust
main/target/
main/Cargo.lock

# Logs and temp files
*.log
*.tmp

# Environment (создаётся из infra/.env.example через make init)
.env
.env.local

# Runtime data (создаётся при запуске)
main/data/trace.db
main/data/trace.db-wal
main/data/trace.db-shm

# Config generated by `make init`
main/config/roles.yaml

# Dev-SSO config (генерируется make dev-roles из main/config/roles.yaml)
infra/dev-roles.yaml

# Runtime nginx config (генерируется infra/k8s/local-proxy.sh start)
infra/k8s/local-proxy/run/

# Editors
.vscode/
.idea/

# Coverage
coverage/
htmlcov/
.coverage
.mypy_cache/
.pytest_cache/
