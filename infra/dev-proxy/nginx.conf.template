# Шаблон nginx-прокси dev-стенда (compose): *.localhost как в k8s-стенде
# (см. infra/k8s/70-ingress.yaml), но с хостом инстанса (<instance> = Linux-
# пользователь): dev.<instance>.localhost → SPA (front),
# api.<instance>.localhost → API (core), auth.<instance>.localhost → Keycloak
# (SSO). Браузер резолвит *.localhost в 127.0.0.1/::1 без /etc/hosts
# (RFC 6761); наружу порт инстанса, контейнер слушает 80.
# Плейсхолдер <instance> подставляет make dev-proxy в nginx.conf (сервис `proxy`,
# infra/dev-compose.yml). В compose-сети сервисы доступны по имени:
# front:80, core:8080, keycloak:8080, centrifugo:8000.
events {}

http {
    # dev.<instance>.localhost и всё остальное — веб-клиент (front).
    server {
        listen 80 default_server;
        server_name dev.__INSTANCE__.localhost __INSTANCE__.localhost _;

        location / {
            proxy_pass http://front;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # api.<instance>.localhost — API (ядро, core).
    server {
        listen 80;
        server_name api.__INSTANCE__.localhost;

        location / {
            proxy_pass http://core:8080;
            proxy_http_version 1.1;
            # Ядро строит redirect_uri SSO из Host — нужен с портом инстанса
            # ($http_host), иначе после входа браузер уйдёт на :80.
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # auth.<instance>.localhost — Keycloak (SSO): authorize_url в dev-roles.yaml.
    server {
        listen 80;
        server_name auth.__INSTANCE__.localhost;

        location / {
            proxy_pass http://keycloak:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # pub-sub.<instance>.localhost — Centrifugo (websocket реального времени
    # для чата). Connection-JWT веб-клиент берёт у ядра; Origin (dev.<instance>)
    # разрешён в CENTRIFUGO_CLIENT_ALLOWED_ORIGINS.
    server {
        listen 80;
        server_name pub-sub.__INSTANCE__.localhost;

        location / {
            proxy_pass http://centrifugo:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}