# -- Compose config -----------------------------------------------------------
COMPOSE_FILES=aga
PORT=8080
RUST_LOG=info

# -- Runtime config ------------------------------------------------------------
# Пути используются локальным запуском (make run); в Docker подменяются.
AGA_CONFIG_PATH=config/roles.yaml
AGA_DB_PATH=data/trace.db

# -- LLM -----------------------------------------------------------------------
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=
