# -- Runtime config ------------------------------------------------------------
# Пути используются локальным запуском (make run); в стенде подменяются.
AGA_CONFIG_PATH=config/roles.yaml
AGA_DB_PATH=data/trace.db

# -- Dev-инстанс (docker compose) ----------------------------------------------
# Инстанс = Linux-пользователь: у каждого свои порты, имена контейнеров и
# named volume (несколько инстансов на одной машине не конфликтуют). Значения
# по умолчанию выводятся из $USER (makefile); переменные ниже — переопределение.
# INSTANCE=alice
# PORT_BASE=20010        # блок из 4 портов: proxy/core/front/keycloak
# NAME_PREFIX=aga-alice  # префикс имён контейнеров (по умолчанию aga-<INSTANCE>)
# WS_PREFIX=aga-alice-   # префикс ws-контейнеров (ищет ядро, AGA_WS_PREFIX)

# Порт ядра для локального make run и k8s-стенда (deploy.sh читает PORT).
# Порт ядра dev-стенда — отдельный: AGA_CORE_PORT (выводится из PORT_BASE).
PORT=8080
RUST_LOG=info

# -- Kubernetes (стенд в minikube) ---------------------------------------------
AGA_K8S_NAMESPACE=aga
AGA_CORE_IMAGE=aga-core:latest
AGA_FRONT_IMAGE=aga-front:latest
AGA_K8S_IMAGE=aga-workstation:latest
AGA_K8S_KUBECTL=kubectl
# Шаблон воркстейшн-пода — относительно CWD ядра (cargo запускается в main/).
AGA_K8S_TEMPLATE=../infra/k8s/workstation-pod.yaml
AGA_K8S_WAIT_TIMEOUT=180

# -- Воркстейшны: backend (default k8s; docker — только dev-стенд) -------------
# k8s  — поды в кластере (kubectl exec); стенд — make k8s-*.
# docker — контейнеры (docker exec); dev-стенд — make dev-* (infra/dev-compose.yml).
# Для make run на хосте в docker-режиме нужен docker CLI на PATH.
AGA_WS_BACKEND=k8s

# -- Нити чата -----------------------------------------------------------------
# Предохранитель от бесконечных переписок участников (в том числе агентов):
# глубина вложенности нитей и число сообщений в одной нити (корневые чаты не
# ограничены). Нужны и ядру, и агент-рантайму; пусто/неверно — дефолт.
AGA_MAX_THREAD_DEPTH=10
AGA_MAX_THREAD_MESSAGES=100

# -- SSO (Keycloak) ------------------------------------------------------------
# Стенд поднимает Keycloak в кластере и включает sso в конфиге ядра
# (см. infra/k8s/core/deploy.sh). Здесь настройки Keycloak не задаются.
# Origin веб-клиента: CORS-источник ядра и адрес возврата токена после входа.
# Локально фронт раздаётся на :8081 — `make run-front` (SSO выключен, ядро
# под анонимом). Для dev-стенда compose задаёт dev.localhost явно (см.
# dev-compose.yml) — туда SSO возвращает токен; в стенде — dev.localhost.
# Идентификатор dev-инстанса: порт инстанса выводится из $USER, SSO-токен
# возвращается на dev.<INSTANCE>.localhost.<AGA_PROXY_PORT>.
# AGA_FRONT_URL=http://localhost:8081 — только для локального make run;
# dev-стенд задаёт адрес явно (dev.<INSTANCE>.localhost:<AGA_PROXY_PORT>).
AGA_FRONT_URL=http://localhost:8081
AGA_K8S_FRONT_URL=http://dev.localhost
# Хост-порт nginx-прокси dev-стенда и порты сервисов. По умолчанию выводятся
# из PORT_BASE (инстанс пользователя); :80 на общей машине занят, поэтому
# proxy слушает порт инстанса, а не 80.
# AGA_PROXY_PORT=20010
# AGA_FRONT_PORT=20012
# KEYCLOAK_PORT=20013

# -- SSH-ключ aga (git+ssh для воркстейшнов) -----------------------------------
# Приватный ключ в OpenSSH-формате (`ssh-keygen -t ed25519`), общий на инстанс.
# Ядро показывает публичный ключ на странице «Настройки» (GET /settings/ssh-key)
# и прокидывает приватный в воркстейшны: k8s — Secret `aga-ssh`, монтируется в
# под; dev-стенд — запись в ~/.ssh контейнера. Пустой — воркстейшны без ssh.
# Многострочный ключ: в .env — двойные кавычки с \n, в compose — блок |.
AGA_SSH_PRIVATE_KEY=